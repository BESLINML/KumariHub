{
    "hosting":  {
                    "public":  "frontend/dist",
                    "ignore":  [
                                   "firebase.json",
                                   "**/.*",
                                   "**/node_modules/**"
                               ],
                    "rewrites":  [
                                     {
                                         "source":  "**",
                                         "function":  {
                                                          "functionId":  "shareMetadata",
                                                          "region":  "asia-south1"
                                                      }
                                     },
                                     {
                                         "source":  "**",
                                         "destination":  "/index.html"
                                     }
                                 ]
                },
    "functions":  {
                      "source":  "functions"
                  }
}

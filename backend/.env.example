# Set this in backend/.env using the pooled connection string from Neon Console > Connect.
# Keep the sslmode=require parameter from Neon. Never commit the real connection string.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-ENDPOINT-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
ADMIN_API_TOKEN=replace-with-a-long-random-token
ADMIN_PASSWORD=choose-a-strong-admin-password
# Brevo transactional email (free plan: 300 sends/day). Verify the sender address in Brevo.
BREVO_API_KEY=your_brevo_api_key
MAIL_FROM_EMAIL=verified-sender@example.com
MAIL_FROM_NAME=KumariHub
